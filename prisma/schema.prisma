generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  email                 String
  phone                 String?
  address               String?
  logoUrl               String?
  primaryColor          String     @default("#667eea")
  secondaryColor        String     @default("#764ba2")
  subscriptionExpiresAt DateTime?
  active                Boolean    @default(true)
  createdAt             DateTime   @default(now())
  users                 User[]
  campaigns             Campaign[]
  vouchers              Voucher[]
  alerts                Alert[]
}

model Campaign {
  id                  String          @id @default(cuid())
  storeId             String
  store               Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  description         String?
  prizes              Json
  gameType            String          @default("scratch_card")
  customerFields      Json            @default("[]")
  playLimitMode       String          @default("per_campaign")
  loseMessage         String          @default("Nessun premio questa volta.")
  voucherValidityDays Int             @default(15)
  active              Boolean         @default(true)
  startDate           DateTime        @db.Date
  endDate             DateTime        @db.Date
  maxPlaysPerUser     Int             @default(1)
  createdAt           DateTime        @default(now())
  prizeItems          Prize[]
  participations      Participation[]
  vouchers            Voucher[]
  alerts              Alert[]

  @@unique([storeId, slug])
}

model Prize {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name              String
  emoji             String?
  description       String?
  winProbability    Float
  totalQuantity     Int
  remainingQuantity Int
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  participations    Participation[]

  @@index([campaignId])
}

model Participation {
  id           String   @id @default(cuid())
  sessionKey   String
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        String
  clientIp     String
  userAgent    String?
  deviceKey    String?
  customerData Json     @default("{}")
  outcome      String   @default("lost")
  prizeId      String?
  prize        Prize?   @relation(fields: [prizeId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  voucher      Voucher?

  @@index([sessionKey, campaignId])
  @@index([email, campaignId])
}

model Voucher {
  id               String        @id @default(cuid())
  code             String        @unique
  participationId  String        @unique
  participation    Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  campaignId       String
  campaign         Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  prize            Json
  email            String
  redeemed         Boolean       @default(false)
  redeemedAt       DateTime?
  redeemedByUserId String?
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  redemptions      Redemption[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  redemptions  Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes     String?
  createdAt DateTime @default(now())
}

model Alert {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type         String
  message      String
  readByAdmin  Boolean   @default(false)
  readByStore  Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([storeId, readByStore])
  @@index([readByAdmin])
}
