generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  email     String
  phone     String?
  address   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  vouchers  Voucher[]
}

model Campaign {
  id              String          @id @default(cuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String?
  prizes          Json
  active          Boolean         @default(true)
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  maxPlaysPerUser Int             @default(1)
  createdAt       DateTime        @default(now())
  participations  Participation[]
  vouchers        Voucher[]

  @@unique([storeId, slug])
}

model Participation {
  id         String   @id @default(cuid())
  sessionKey String
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  clientIp   String
  createdAt  DateTime @default(now())
  voucher    Voucher?

  @@index([sessionKey, campaignId])
}

model Voucher {
  id              String        @id @default(cuid())
  code            String        @unique
  participationId String        @unique
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  prize           Json
  email           String
  redeemed        Boolean       @default(false)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  storeId      String
  createdAt    DateTime @default(now())
}
