# Supabase PostgreSQL — Connection Pooler (Transaction mode, porta 6543)
# Dashboard Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct connection (porta 5432) — richiesta per prisma migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Super-admin (login API — non usato dal gioco pubblico in Fase 1)
ADMIN_EMAIL="admin@grattavinci.it"
ADMIN_PASSWORD="cambia-questa-password"
