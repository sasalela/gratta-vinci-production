# Nomi delle variabili. Sostituisci i segnaposto nel tuo ambiente, non in git.
# Vedi README per il collegamento a Postgres e per le migrazioni su Vercel.

# Postgres pooled (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Postgres diretto (solo prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Super-admin e firma dei token di accesso
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"
JWT_SECRET="replace-with-at-least-32-random-characters"

# Facoltative
# APP_BASE_URL="https://your-domain.example"
# TRIAL_DAYS="14"
# EMAIL_VERIFICATION_TTL_HOURS="24"
# MAIL_FROM="Negozio <noreply@example.com>"
# RESEND_API_KEY=""
# MAIL_WEBHOOK_URL=""
